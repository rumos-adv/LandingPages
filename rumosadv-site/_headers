# Cloudflare Pages — Security & Performance Headers
# Documentação: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block

# Cache longo para assets imutáveis
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache curto para HTML (permite atualizações rápidas)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

/divorcio
  Cache-Control: public, max-age=300, must-revalidate
